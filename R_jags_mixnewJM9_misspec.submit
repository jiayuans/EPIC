+SingularityImage = "osdf:///ospool/ap40/data/jiayuan.shi/rlib.sif"
executable        = Simulation_mixnewJM9_misspec.R
arguments = nonmixJM.X_newdata8.$(Process).csv nonmixJM.Y_newdata8.$(Process).csv nonmixJM.rec_newdata8.$(Process).csv long.data_new600.csv
transfer_input_files = nonmixJM.X_newdata8.$(Process).csv, nonmixJM.Y_newdata8.$(Process).csv, nonmixJM.rec_newdata8.$(Process).csv, long.data_new600.csv
transfer_output_files = mixJM.newresult9_misspec.$(Process).csv, dicwaic_mixJM9_misspec.$(Process).csv, mixJM.classification_summary9_misspec.$(Process).csv


log    = R.log.$(Cluster).$(Process)
error  = R.err.$(Cluster).$(Process)
output = R.out.$(Cluster).$(Process)

+JobDurationCategory = "Long"

request_cpus   = 4
request_memory = 12GB
request_disk   = 12GB

queue 500