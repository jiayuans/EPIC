+SingularityImage = "osdf:///ospool/ap40/data/jiayuan.shi/rlib.sif"
executable        = Simulation_mixnewJM12_misspec.R
arguments = nonmixJM.X_newdata5.$(Process).csv nonmixJM.Y_newdata5.$(Process).csv nonmixJM.rec_newdata5.$(Process).csv long.data_new600.csv
transfer_input_files = nonmixJM.X_newdata5.$(Process).csv, nonmixJM.Y_newdata5.$(Process).csv, nonmixJM.rec_newdata5.$(Process).csv, long.data_new600.csv
transfer_output_files = nonmixJM.newresult12_misspec.$(Process).csv, dicwaic_nonmixJM12_misspec.$(Process).csv

log    = R.log.$(Cluster).$(Process)
error  = R.err.$(Cluster).$(Process)
output = R.out.$(Cluster).$(Process)

+JobDurationCategory = "Long"

request_cpus   = 4
request_memory = 12GB
request_disk   = 12GB

queue 500